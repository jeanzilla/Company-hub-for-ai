# Copy this file to .env.local and fill it in. Never push .env.local to Git.

# The hub's Postgres (Supabase, Neon or any other). In Supabase: Connect → Transaction pooler.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Key that encrypts the connector secrets. 32 bytes in base64. Generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If it is lost, the stored secrets cannot be read: keep a copy outside the server too.
HUB_ENCRYPTION_KEY=

# Public address of the hub, without a trailing slash. On your computer: http://localhost:3000
HUB_URL=http://localhost:3000

# Optional: sign in with Google as well as with email and password.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
